# ── Cerebro ──────────────────────────────────────────────────────────────
# gemini = LLM en la nube (Google AI Studio) · local = Ollama en esta PC
LLM_PROVIDER=gemini

# Clave gratuita: https://aistudio.google.com/apikey  (no la compartas ni la subas a git)
GEMINI_API_KEY=
# gemini-3.6-flash (estable) · gemini-3.5-flash-lite (más rápido y con más cuota gratuita)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_REASONING=minimal
# La capa gratuita limita las peticiones diarias por modelo (20 al día en gemini-3.6-flash). Al agotarse uno
# se pasa al siguiente de esta lista y, si LOCAL_FALLBACK=true, al modelo local cuando no queda ninguno.
# gemma-4-26b-a4b-it usa la misma clave y tiene una cuota gratuita mucho mayor.
GEMINI_FALLBACK=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-26b-a4b-it
LOCAL_FALLBACK=true

OLLAMA_URL=http://127.0.0.1:11434
# El modelo local comparte la GPU con la voz (~5 GB) y Whisper (~1 GB): con 16 GB tiene que ser pequeño
# (gemma4:12b no cabe). Si el principal no cabe en ese momento, se pasa solo a los de OLLAMA_FALLBACK.
#   ollama pull gemma4:e4b-it-qat   ·   ollama pull gemma4:e2b-it-qat
OLLAMA_MODEL=gemma4:e4b-it-qat
OLLAMA_FALLBACK=gemma4:e2b-it-qat

# ── Temas +18 ────────────────────────────────────────────────────────────
# No hay interruptor: van implícitos con el cerebro local (si el personaje lo permite en su ficha) y nunca
# con la nube.

# ── Mirada en vivo ───────────────────────────────────────────────────────
# Mientras compartes la cámara o la pantalla, Mika mira por su cuenta y comenta. Segundos entre miradas,
# mínimo entre comentarios, y el modelo que la hace con el cerebro en la nube (cuota aparte de la conversación).
WATCH_INTERVAL=7
WATCH_GAP=20
WATCH_MODEL=gemma-4-26b-a4b-it

# ── Personaje y usuario ──────────────────────────────────────────────────
PERSONA=personas/mika.json
USER_NAME=
TIMEZONE=America/Lima

# ── Voz ──────────────────────────────────────────────────────────────────
# Voz completa: servidor propio (voz/servidor.py), que el companion arranca solo en este puerto.
TTS_URL=http://127.0.0.1:8210
# Solo si TTS_URL apunta a un servidor de voz externo que pida token.
TTS_TOKEN=
# completa (F5-TTS, tarjeta NVIDIA) o ligera (Piper, procesador). Lo elegido en la bienvenida manda.
VOICE_ENGINE=completa
TTS_VOICE=mika_es

# ── Oído (Whisper local) ─────────────────────────────────────────────────
# large-v3-turbo: 1,1 GB de memoria de vídeo y 3 veces más rápido que large-v3, con los mismos aciertos en español.
STT_MODEL=large-v3-turbo
STT_DEVICE=auto
STT_COMPUTE=int8_float16
STT_LANGUAGE=es

# ── Turnos de conversación ───────────────────────────────────────────────
END_SILENCE_MS=550
BARGE_IN=true

HOST=127.0.0.1
PORT=8200
